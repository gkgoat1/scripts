{
  "name": "agentweave-pi-mcp",
  "version": "0.1.0",
  "description": "Pi extension and reusable MCP client bridge for AgentWeave",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": ["dist"],
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts --clean",
    "test": "tsc --noEmit && npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "typebox": "^1.2.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.0 <0.84.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
